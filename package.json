{
  "name": "embarcadino",
  "version": "2.0.0",
  "description": "Assistente de IA do Ciência Embarcada no Telegram — pesquisa na web, consulta o blog e redige posts",
  "type": "module",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrguerra/embarcadino.git"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "test": "node --test test/",
    "build": "esbuild src/index.js --bundle --platform=node --target=node20 --outfile=dist/bot.js --external:node:*"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "telegram",
    "bot",
    "openrouter",
    "iot",
    "sistemas-embarcados"
  ],
  "author": "lucasrguerra",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lucasrguerra/embarcadino/issues"
  },
  "homepage": "https://github.com/lucasrguerra/embarcadino#readme",
  "dependencies": {
    "cheerio": "^1.0.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
